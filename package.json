{
  "name": "toca-disco-vega",
  "version": "1.0.0",
  "private": true,
  "description": "Toca Disco para Fire TV con Vega OS (Fire TV Stick 4K Select y Fire TV Stick HD 2026)",
  "scripts": {
    "start": "react-native start",
    "build:debug": "react-native build-vega --build-type Debug --target armv7",
    "build:release": "react-native build-vega --build-type Release --target armv7",
    "install:debug": "vega device install-app --directory . --buildType Debug",
    "install:release": "vega device install-app --directory . --buildType Release",
    "launch": "vega device launch-app --directory ."
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "~2.0.0",
    "@amazon-devices/webview": "~3.3.0",
    "react": "18.2.0",
    "react-native": "0.72.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "~0.22.14",
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "11.3.2",
    "@react-native/metro-config": "0.72.6",
    "@tsconfig/react-native": "^3.0.2",
    "metro-react-native-babel-preset": "0.76.5",
    "metro-react-native-babel-transformer": "0.76.5",
    "typescript": "4.8.4"
  },
  "kepler": {
    "projectType": "application",
    "appName": "Toca Disco",
    "targets": ["tv"]
  }
}
